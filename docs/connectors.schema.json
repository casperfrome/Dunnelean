{
  "connectors": [
    {
      "reader": {
        "consistency": [
          "snapshot",
          "statement"
        ],
        "protocol": "binary prepared streaming",
        "range_split": "integer only; includes NULL and both tails"
      },
      "type": "mysql",
      "writer": {
        "modes": [
          "insert",
          "upsert"
        ],
        "transaction": "one InnoDB transaction per batch"
      }
    },
    {
      "reader": {
        "experimental": true,
        "prepared_parameters": false,
        "protocol": "Arrow Flight SQL"
      },
      "type": "doris",
      "version": "4.1.4",
      "writer": {
        "models": [
          "DUPLICATE KEY",
          "UNIQUE KEY merge-on-write"
        ],
        "modes": [
          "append",
          "upsert"
        ],
        "protocol": "Arrow IPC Stream Load"
      }
    }
  ],
  "limits": {
    "memory": "split between reader buffers and queued conversion/encoding buffers; not an OS RSS cap",
    "ordering": "parallel readers/writers do not guarantee row order",
    "resume": false,
    "schema_conversion": "only exact scalar conversions; unsupported types require explicit source SQL",
    "time_zone": "fixed ±HH:MM, default +00:00",
    "unknown_fields": "rejected"
  },
